---
import Shell from "../layouts/Shell.astro";
import LessonList from "../components/curriculum/LessonList.astro";
import { toListItems } from "../components/curriculum/items";
import { loadCurriculum } from "../content/curriculum";
import { trackHref } from "../links";

const { tracks, lessons } = await loadCurriculum();
---

<Shell title="Java Visuals">
  <main class="home">
    <h1>Java Visuals</h1>
    <p class="lede">
      Learn Java by watching it run: every Frame pushed onto the Stack, every object placed on the Heap, every Reference
      drawn.
    </p>
    <ol class="tracks">
      {
        tracks.map((track) => (
          <li class="track">
            <h2>
              <a href={trackHref(track.id)}>{track.data.title}</a>
            </h2>
            <p>{track.data.description}</p>
            {track.lessons.length > 0 && <LessonList compact lessons={toListItems(track.lessons, lessons)} />}
          </li>
        ))
      }
    </ol>
  </main>
</Shell>

<style>
  .home {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1rem 4rem;
  }
  h1 {
    font-size: 2.75rem;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    letter-spacing: -0.015em;
  }
  .lede {
    font-size: 1.25rem;
    max-width: 58ch;
    margin: 0 0 2.5rem;
  }
  .tracks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .track {
    border-top: 3px solid var(--stack);
    padding-top: 1rem;
  }
  .track h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .track p {
    margin: 0.375rem 0 1rem;
    max-width: 60ch;
  }
</style>
