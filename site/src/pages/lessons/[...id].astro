---
import Shell from "../../layouts/Shell.astro";
import Pager from "../../components/nav/Pager.astro";
import ExecutionLesson from "../../components/lessons/ExecutionLesson.tsx";
import TimelineLesson from "../../components/lessons/TimelineLesson.tsx";
import AnimationLesson from "../../components/lessons/AnimationLesson.tsx";
import { loadCurriculum, trackOf, type LessonEntry } from "../../content/curriculum";
import { loadExecutionLesson } from "../../content/executionLesson";
import { loadTimelineLesson } from "../../content/loadTimelineLesson";
import { loadAnimationLesson } from "../../content/loadAnimationLesson";
import { href, trackHref } from "../../links";
import { neighbours, readingOrder } from "../../content/order";

export async function getStaticPaths() {
  const { tracks, lessons } = await loadCurriculum();
  return [...lessons.values()].map((lesson) => {
    const track = tracks.find((t) => t.id === trackOf(lesson.id))!;
    const { previous, next } = neighbours(readingOrder(tracks), lesson.id);
    return {
      params: { id: lesson.id },
      props: { lesson, lessons, track: { id: track.id, title: track.data.title }, previous, next },
    };
  });
}

interface Props {
  lesson: LessonEntry;
  lessons: Map<string, LessonEntry>;
  track: { id: string; title: string };
  previous: LessonEntry | undefined;
  next: LessonEntry | undefined;
}
const { lesson, lessons, track, previous, next } = Astro.props;
const execution = lesson.data.kind === "execution" ? loadExecutionLesson(lesson) : undefined;
const timeline = lesson.data.kind === "timeline" ? loadTimelineLesson(lesson, lessons) : undefined;
const animation = lesson.data.kind === "animation" ? loadAnimationLesson(lesson) : undefined;
---

<Shell title={`${lesson.data.title} | Java Visuals`} description={lesson.data.summary} current={lesson.id}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={href("/")}>Java Visuals</a>
    <span aria-hidden="true">/</span>
    <a href={trackHref(track.id)}>{track.title}</a>
  </nav>
  <main>
  {
    execution && (
      <ExecutionLesson
        client:load
        variants={execution.variants}
        variantLabels={execution.variantLabels}
        script={execution.script}
        defaultLevel={lesson.data.detail}
        view={lesson.data.view}
        scene={lesson.data.scene}
      />
    )
  }
  {timeline && <TimelineLesson client:load timeline={timeline.timeline} script={timeline.script} />}
  {animation && <AnimationLesson client:load data={animation.data} script={animation.script} />}
  </main>
  <Pager previous={previous} next={next} />
</Shell>

<style>
  .crumbs {
    max-width: 90rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 0;
    display: flex;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  @media (max-width: 40rem) {
    .crumbs {
      padding: 0.75rem 1rem 0;
    }
  }
</style>
