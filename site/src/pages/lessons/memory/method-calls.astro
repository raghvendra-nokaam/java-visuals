---
import type { Trace } from "@java-visuals/trace-schema";
import Base from "../../../layouts/Base.astro";
import ExecutionLesson from "../../../components/lessons/ExecutionLesson.tsx";
import type { LessonScript } from "../../../player/script";
// Generated by the recorder (npm run record); not committed.
import trace from "../../../../../lessons/memory/method-calls/traces/default.json";
import script from "../../../../../lessons/memory/method-calls/script.json";

const lesson = script as LessonScript;
---

<Base title={`${lesson.title} | Java Visuals`}>
  <ExecutionLesson
    client:load
    variants={{ default: trace as unknown as Trace }}
    script={lesson}
    defaultLevel="simple"
  />
</Base>
