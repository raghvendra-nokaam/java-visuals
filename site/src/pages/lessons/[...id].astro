---
import Base from "../../layouts/Base.astro";
import ExecutionLesson from "../../components/lessons/ExecutionLesson.tsx";
import TimelineLesson from "../../components/lessons/TimelineLesson.tsx";
import PipelineLesson from "../../components/lessons/PipelineLesson.tsx";
import { loadCurriculum, trackOf, type LessonEntry } from "../../content/curriculum";
import { loadExecutionLesson } from "../../content/executionLesson";
import { loadTimelineLesson } from "../../content/loadTimelineLesson";
import { loadPipelineLesson } from "../../content/loadPipelineLesson";
import { href, trackHref } from "../../links";

export async function getStaticPaths() {
  const { tracks, lessons } = await loadCurriculum();
  return [...lessons.values()].map((lesson) => {
    const track = tracks.find((t) => t.id === trackOf(lesson.id))!;
    const position = track.lessons.indexOf(lesson);
    return {
      params: { id: lesson.id },
      props: { lesson, lessons, track: { id: track.id, title: track.data.title }, next: track.lessons[position + 1] },
    };
  });
}

interface Props {
  lesson: LessonEntry;
  lessons: Map<string, LessonEntry>;
  track: { id: string; title: string };
  next: LessonEntry | undefined;
}
const { lesson, lessons, track, next } = Astro.props;
const nextLink = next ? { title: next.data.title, href: href(`lessons/${next.id}/`) } : undefined;
const execution = lesson.data.kind === "execution" ? loadExecutionLesson(lesson) : undefined;
const timeline = lesson.data.kind === "timeline" ? loadTimelineLesson(lesson, lessons) : undefined;
const pipeline = lesson.data.kind === "pipeline" ? loadPipelineLesson(lesson) : undefined;
---

<Base title={`${lesson.data.title} | Java Visuals`} description={lesson.data.summary}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={href("/")}>Java Visuals</a>
    <span aria-hidden="true">/</span>
    <a href={trackHref(track.id)}>{track.title}</a>
  </nav>
  {
    execution && (
      <ExecutionLesson
        client:load
        lessonId={lesson.id}
        variants={execution.variants}
        variantLabels={execution.variantLabels}
        script={execution.script}
        defaultLevel={lesson.data.detail}
        next={nextLink}
      />
    )
  }
  {timeline && <TimelineLesson client:load lessonId={lesson.id} timeline={timeline.timeline} script={timeline.script} next={nextLink} />}
  {pipeline && <PipelineLesson client:load lessonId={lesson.id} data={pipeline.data} script={pipeline.script} next={nextLink} />}
</Base>

<style>
  .crumbs {
    max-width: 90rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 0;
    display: flex;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  @media (max-width: 40rem) {
    .crumbs {
      padding: 0.75rem 1rem 0;
    }
  }
</style>
